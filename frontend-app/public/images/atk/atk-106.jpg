/* =========================
   HEADER CLEANUP
========================= */
.header-v4 .masthead {
    padding: 0;
}

.masthead .header-logo-area {
    position: relative;
    width: 100%;
    padding: 0 15px;
    margin: 0;
}

/* =========================
   FOOTER (MOBILE)
========================= */
.handheld-footer .footer-call-us {
    max-width: 380px;
    width: auto;
    margin: 0;
}

/* =========================
   DEAL / BANNER TEXT
========================= */
.da-block .da-text {
    font-weight: 300; /* modern thin */
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* =========================
   SLIDER / PROMO BLOCK
========================= */
.vertical-menu-slider-category-with-das-inner 
.slider-das-block .da-block {
    position: relative;
}

.vertical-menu-slider-category-with-das-inner 
.slider-das-block .da-block .da-media-body {
    width: 100%;
    z-index: 2;
    margin-top: -60px; /* slightly softer */
}

.vertical-menu-slider-category-with-das-inner 
.slider-das-block .da-block .da-media-left {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 140px;
    height: auto;
}

/* =========================
   CONTAINER WIDTH (RESPONSIVE)
========================= */
.container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 15px;
}

/* =========================
   FORM INPUTS (BETTER UX)
========================= */
.comment-form input,
.comment-form textarea {
    width: 100%;
    max-width: 600px;
    border-radius: 8px;
    padding: 10px;
    border: 1px solid #ddd;
    transition: 0.3s ease;
}

.comment-form input:focus,
.comment-form textarea:focus {
    border-color: #2d2f8e;
    outline: none;
}

/* =========================
   REMOVE AUTHOR BOX (CLEAN UI)
========================= */
.post-author-info {
    display: none;
}

/* =========================
   MOBILE MENU (SMOOTH SCROLL)
========================= */
#menu-mobile-header-menu-new {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    overflow-y: hidden;
    white-space: nowrap;
    padding: 0 10px;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
}

/* Hide scrollbar (clean look) */
#menu-mobile-header-menu-new::-webkit-scrollbar {
    display: none;
}

/* Menu Items */
#menu-mobile-header-menu-new .menu-item {
    flex: 0 0 auto;
}

/* Menu Images */
.menu-image-title-below img {
    height: 50px !important;
    width: auto !important;
    display: block;
    margin: 0 auto;
}

/* Menu Text */
.menu-image-title-below {
    width: 70px;
    font-size: 11px;
    font-weight: 500;
    text-align: center;
}

/* =========================
   PRODUCT GALLERY FIX
========================= */
.woocommerce div.product div.images.flex-control-nav {
    opacity: 1;
}

#menu-header-support{
    justify-content:center;
}

@media (min-width: 1200px) {
    .header-icon a,
.header-icons a,
.site-header a[data-bs-toggle="dropdown"]{
    width:42px;
    height:42px;
    background:#191966;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
}

.header-icon .ec-user,
.header-icons .ec-user,
.site-header .ec-user{
    color:#fff;
    font-size:18px;
}
	#menu-header-support i {
        margin-right: 8px;
    }
	
	#menu-header-support li a:hover{
		color:#f5a623; }
}
</style>
</head>

