				<div class="elementor-widget-container">
					<script>
(function(){
  if(window.__foretecLoopCartV1) return;
  window.__foretecLoopCartV1 = true;
  function updateCards(){
    document.querySelectorAll('.elementor-33540.e-loop-item').forEach(function(card){
      var button = card.querySelector('.elementor-element-7556c459 a.elementor-button');
      var imageLink = card.querySelector('.elementor-element-1d3a18d0 a[href]');
      var titleLink = card.querySelector('.elementor-element-f7c8be84 a[href]');
      var match = card.className.match(/(?:^|\s)e-loop-item-(\d+)(?:\s|$)/);
      if(!button || !match) return;
      var label = button.querySelector('.elementor-button-text');
      var productUrl = (imageLink || titleLink || button).href;
      var canAdd = card.classList.contains('product-type-simple') && card.classList.contains('instock') && card.classList.contains('purchasable');
      if(canAdd){
        var productId = match[1];
        var cartUrl = new URL('/', window.location.origin);
        cartUrl.searchParams.set('add-to-cart', productId);
        button.href = cartUrl.href;
        button.classList.add('add_to_cart_button','ajax_add_to_cart','product_type_simple');
        button.dataset.product_id = productId;
        button.dataset.quantity = '1';
        button.setAttribute('rel','nofollow');
        button.setAttribute('aria-label','Add this product to your cart');
        if(label && label.textContent !== 'Add to cart') label.textContent = 'Add to cart';
      } else {
        button.href = productUrl;
        button.classList.remove('add_to_cart_button','ajax_add_to_cart','product_type_simple');
        button.removeAttribute('data-product_id');
        button.removeAttribute('data-quantity');
        button.removeAttribute('rel');
        button.removeAttribute('aria-label');
        var text = card.classList.contains('product-type-variable') ? 'Select options' : 'View product';
        if(label && label.textContent !== text) label.textContent = text;
      }
    });
  }
  var queued = false;
  function schedule(){
    if(queued) return;
    queued = true;
    window.requestAnimationFrame(function(){queued=false;updateCards();});
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded',schedule,{once:true});
  else schedule();
  new MutationObserver(schedule).observe(document.documentElement,{childList:true,subtree:true});
})();
</script>				</div>
