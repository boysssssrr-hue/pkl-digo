      var titleLink = card.querySelector('.elementor-element-f7c8be84 a[href]');
      var match = card.className.match(/(?:^|\s)e-loop-item-(\d+)(?:\s|$)/);
      if(!button || !match) return;
      var label = button.querySelector('.elementor-button-text');
      var productUrl = (imageLink || titleLink || button).href;
      var canAdd = card.classList.contains('product-type-simple') && card.classList.contains('instock') && card.classList.contains('purchasable');
      if(canAdd){
